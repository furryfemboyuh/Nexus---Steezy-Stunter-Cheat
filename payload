    document.head.appendChild(style);

    const shadow = JSON.parse(localStorage.getItem("sg_shadow_v1") || "{}");
    const game = JSON.parse(localStorage.getItem("steezycentral_v6") || "{}");

    const shadowBest = shadow.d?.best || {};
    const gameBest = game.best || {};

    const keys = [...new Set([
        ...Object.keys(shadowBest),
        ...Object.keys(gameBest)
    ])];

    const root = document.createElement("div");
    root.id = "steezy-save-editor";

    root.innerHTML = `
        <div class="panel">
            <aside class="sidebar">
                <div class="brand">
                    <div class="brand-icon">V</div>
                    <div class="brand-text">
                        <div class="brand-name">VANTA</div>
                        <div class="brand-sub">SAVE EDITOR</div>
                    </div>
                </div>

                <div class="nav-label">WORKSPACE</div>
                <div class="nav-item active">
                    <span class="nav-icon">◈</span>
                    <span class="nav-text">Save Editor</span>
                </div>
                <div class="nav-item">
                    <span class="nav-icon">▤</span>
                    <span class="nav-text">Player Data</span>
                </div>
                <div class="nav-item">
                    <span class="nav-icon">◆</span>
                    <span class="nav-text">Records</span>
                </div>

                <div class="sidebar-bottom">
                    <div class="online">
                        <span class="online-dot"></span>
                        LOCAL STORAGE
                    </div>
                    <div class="sidebar-version">VANTA • VERSION 2.0</div>
                </div>
            </aside>

            <main class="main">
                <header class="topbar">
                    <div>
                        <div class="page-title">Save Editor</div>
                        <div class="page-subtitle">Customize your local game data</div>
                    </div>
                    <button class="close" title="Close">✕</button>
                </header>

                <div class="content">
                    <div class="welcome">
                        <div class="welcome-tag">VANTA CONTROL PANEL</div>
                        <div class="welcome-title">Welcome back.</div>
                        <div class="welcome-text">Manage your player balance and game records.</div>
                    </div>

                    <div class="stats">
                        <div class="stat">
                            <div class="stat-label">RECORDS FOUND</div>
                            <div class="stat-value" id="vanta-record-count">${keys.length}</div>
                        </div>
                        <div class="stat">
                            <div class="stat-label">CURRENT CASH</div>
                            <div class="stat-value" id="vanta-cash-stat">0</div>
                        </div>
                        <div class="stat">
                            <div class="stat-label">SAVE STATUS</div>
                            <div class="stat-value" style="font-size:15px;color:#8dffb2">● LOADED</div>
                        </div>
                    </div>

                    <div class="section-heading">
                        <div class="section-title">PLAYER BALANCE</div>
                    </div>
                    <div class="cash-card" id="vanta-cash-box"></div>

                    <div class="section-heading">
                        <div class="section-title">BIKE & STAGE RECORDS</div>
                        <div class="search-wrap">
                            <span class="search-icon">⌕</span>
                            <input id="vanta-search" type="text" placeholder="Search records...">
                        </div>
                    </div>

                    <div id="vanta-entries"></div>
                    <div class="empty" id="vanta-empty">No matching records found.</div>
                </div>

                <footer class="footer">
                    <div class="footer-hint">Changes are saved to your browser storage.</div>
                    <div class="footer-buttons">
                        <button class="cancel">Cancel</button>
                        <button class="apply">APPLY CHANGES ↗</button>
                    </div>
                </footer>
            </main>
            <div class="toast" id="vanta-toast"></div>
        </div>
    `;

    document.body.appendChild(root);

    const $ = selector => root.querySelector(selector);
    const cashValue = game.cash ?? shadow.d?.cash ?? 0;

    const close = () => {
        root.style.opacity = "0";
        root.style.transition = "opacity .2s";
        setTimeout(() => {
            root.remove();
            style.remove();
        }, 200);
    };

    $(".close").onclick = close;
    $(".cancel").onclick = close;

    root.addEventListener("click", event => {
        if (event.target === root) close();
    });

    const toast = message => {
        const el = $("#vanta-toast");
        el.textContent = message;
        el.classList.add("show");
        clearTimeout(el._timer);
        el._timer = setTimeout(() => el.classList.remove("show"), 2600);
    };

    const makeInput = (label, value, field) => {
        const wrap = document.createElement("div");
        const lab = document.createElement("label");
        lab.textContent = label;

        const input = document.createElement("input");
        input.type = "number";
        input.step = "any";
        input.min = "0";
        input.value = value ?? 0;
        input.dataset.field = field;

        wrap.append(lab, input);
        return wrap;
    };

    const cashBox = $("#vanta-cash-box");
    const cashInput = makeInput("CASH BALANCE", cashValue, "cash");
    cashBox.appendChild(cashInput);

    const cashField = cashInput.querySelector("input");

    const updateCashStat = () => {
        const value = Number(cashField.value);
        $("#vanta-cash-stat").textContent =
            Number.isFinite(value) ? value.toLocaleString() : "—";
    };

    cashField.addEventListener("input", updateCashStat);
    updateCashStat();

    const entries = $("#vanta-entries");
    const inputs = [];

    keys.forEach((key, index) => {
        const s = shadowBest[key] || {};
        const g = gameBest[key] || {};

        const entry = document.createElement("div");
        entry.className = "entry";
        entry.style.animationDelay = `${Math.min(index * 25, 400)}ms`;
        entry.dataset.search = key.toLowerCase().replaceAll("_", " ");

        const title = document.createElement("div");
        title.className = "entry-title";

        const icon = document.createElement("span");
        icon.className = "entry-icon";
        icon.textContent = "◆";

        const name = document.createElement("span");
        name.textContent = key.replaceAll("_", " ").toUpperCase();

        title.append(icon, name);

        const fields = document.createElement("div");
        fields.className = "fields";

        const wheelie = makeInput("LONGEST WHEELIE", g.wheelie ?? s.w ?? 0, "wheelie");
        const score = makeInput("BEST SCORE", g.score ?? s.s ?? 0, "score");
        const chal = makeInput("CHALLENGE", g.chal ?? 0, "chal");

        fields.append(wheelie, score, chal);
        entry.append(title, fields);
        entries.appendChild(entry);

        inputs.push({ key, entry, wheelie, score, chal });
    });

    const search = $("#vanta-search");

    search.addEventListener("input", () => {
        const query = search.value.trim().toLowerCase();
        let visible = 0;

        for (const item of inputs) {
            const match = item.entry.dataset.search.includes(query);
            item.entry.style.display = match ? "" : "none";
            if (match) visible++;
        }

        $("#vanta-record-count").textContent = `${visible}/${keys.length}`;
        $("#vanta-empty").style.display = visible ? "none" : "block";
    });

    $(".apply").onclick = () => {
        const cash = Number(cashField.value);

        if (!Number.isSafeInteger(cash) || cash < 0) {
            toast("Enter a valid whole-number cash amount.");
            cashField.focus();
            return;
        }

        for (const item of inputs) {
            const values = [
                item.wheelie.querySelector("input").value,
                item.score.querySelector("input").value,
                item.chal.querySelector("input").value
            ].map(Number);

            if (values.some(v => !Number.isFinite(v) || v < 0)) {
                toast("One or more record values are invalid.");
                return;
            }
        }

        shadow.d ??= {};
        shadow.d.best ??= {};
        shadow.d.cash = cash;

        game.best ??= {};
        game.cash = cash;

        for (const item of inputs) {
            const [wheelie, score, chal] = [
                item.wheelie,
                item.score,
                item.chal
            ].map(el => Number(el.querySelector("input").value));

            shadow.d.best[item.key] ??= {};
            shadow.d.best[item.key].w = wheelie;
            shadow.d.best[item.key].s = score;

            game.best[item.key] ??= {};
            game.best[item.key].wheelie = wheelie;
            game.best[item.key].score = score;
            game.best[item.key].chal = chal;
        }

        try {
            localStorage.setItem("sg_shadow_v1", JSON.stringify(shadow));
            localStorage.setItem("steezycentral_v6", JSON.stringify(game));

            toast("Save updated successfully! Reloading...");

            $(".apply").disabled = true;
            $(".apply").textContent = "SAVED ✓";

            setTimeout(() => location.reload(), 1100);
        } catch (error) {
            toast("Could not save: " + error.message);
            $(".apply").disabled = false;
        }
    };

    const escapeHandler = event => {
        if (event.key === "Escape") {
            close();
            document.removeEventListener("keydown", escapeHandler);
        }
    };

    document.addEventListener("keydown", escapeHandler);
})();
